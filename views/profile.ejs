<%- include('./partials/header') %>

<div class="min-h-screen bg-[#F4F1EE] py-10 px-6">

```
<div class="max-w-5xl mx-auto">

    <h1 class="text-4xl font-bold text-[#5A0000] mb-8">
        My Profiles
    </h1>

    <div class="bg-white rounded-3xl shadow-xl overflow-hidden">

        <!-- Profile Header -->
        <div class="bg-[#5A0000] h-40 relative">

            <div class="absolute -bottom-14 left-10">
                <div
                    class="w-28 h-28 rounded-full bg-white border-4 border-white flex items-center justify-center text-4xl font-bold text-[#5A0000] shadow-lg">

                    <%= user.fullname.charAt(0).toUpperCase() %>

                </div>
            </div>

        </div>

        <!-- Profile Content -->
        <div class="pt-20 px-10 pb-10">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

                <div>
                    <label class="text-gray-500 text-sm">
                        Full Name
                    </label>

                    <div
                        class="mt-2 bg-[#F4F1EE] rounded-xl p-4 text-lg font-semibold">
                        <%= user.fullname %>
                    </div>
                </div>

                <div>
                    <label class="text-gray-500 text-sm">
                        Email Address
                    </label>

                    <div
                        class="mt-2 bg-[#F4F1EE] rounded-xl p-4 text-lg font-semibold">
                        <%= user.email %>
                    </div>
                </div>

                <div>
                    <label class="text-gray-500 text-sm">
                        Contact Number
                    </label>

                    <div
                        class="mt-2 bg-[#F4F1EE] rounded-xl p-4 text-lg font-semibold">
                        <%= Number(9770454585) %>
                    </div>
                </div>

                <div>
                    <label class="text-gray-500 text-sm">
                        Total Cart Items
                    </label>

                    <div
                        class="mt-2 bg-[#F4F1EE] rounded-xl p-4 text-lg font-semibold">
                        <%= user.cart.length %>
                    </div>
                </div>

                <div>
                    <label class="text-gray-500 text-sm">
                        Total Orders
                    </label>

                    <div
                        class="mt-2 bg-[#F4F1EE] rounded-xl p-4 text-lg font-semibold">
                        <%= user.orders.length %>
                    </div>
                </div>

                <div>
                    <label class="text-gray-500 text-sm">
                        Account Type
                    </label>

                    <div
                        class="mt-2 bg-[#F4F1EE] rounded-xl p-4 text-lg font-semibold">
                        <%= user.isadmin ? "Admin" : "Customer" %>
                    </div>
                </div>

            </div>

            <div class="mt-10 flex gap-4">

                <a href="/shop"
                    class="bg-[#5A0000] text-white px-6 py-3 rounded-xl hover:bg-[#7a0000] transition">
                    Continue Shopping
                </a>

                <a href="/logout"
                    class="bg-gray-200 px-6 py-3 rounded-xl hover:bg-gray-300 transition">
                    Logout
                </a>

            </div>

        </div>

    </div>

</div>
```


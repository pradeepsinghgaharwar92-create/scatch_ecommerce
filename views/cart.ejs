<%- include('./partials/header') %>

<div class="w-full min-h-screen flex items-start px-20 py-20 gap-10">

```

<div class="w-[70%]">

    <% cartItems.forEach(function(item){ %>

    <div class="bg-white rounded-lg shadow-md p-5 mb-5 flex items-center gap-5">

        <img
            class="w-40 h-40 object-cover rounded"
            src="data:image/jpeg;base64,<%= item.product.Image.toString('base64') %>"
            alt=""
        >

        <div class="flex-1">

            <h2 class="text-2xl font-semibold">
                <%= item.product.name %>
            </h2>

            <h3 class="text-lg mt-2">
                ₹ <%= item.product.price %>
            </h3>

            <p class="text-green-600 mt-1">
                Discount: <%= item.product.discount %>%
            </p>

            <div class="flex items-center gap-3 mt-4">

                <a
                    href="/cart/decrease/<%= item.product._id %>"
                    class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center">

                    <i class="ri-subtract-line"></i>

                </a>

                <span class="font-semibold text-lg">
                    <%= item.quantity %>
                </span>

                <a
                    href="/cart/increase/<%= item.product._id %>"
                    class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center">

                    <i class="ri-add-line"></i>

                </a>

            </div>

        </div>

    </div>

    <% }) %>

</div>

<!-- Right Side Price Summary -->
<div class="w-[30%] bg-white rounded-lg shadow-md p-6 sticky top-10">

    <h2 class="text-2xl font-semibold mb-5">
        Price Breakdown
    </h2>

    <div class="flex justify-between mb-3">
        <span>Total Amount</span>
        <span>₹ <%= bill %></span>
    </div>

    <div class="flex justify-between mb-3">
        <span>Platform Fee</span>
        <span>₹ 20</span>
    </div>

    <div class="flex justify-between mb-3">
        <span>Shipping</span>
        <span class="text-green-600">FREE</span>
    </div>

    <hr class="my-4">

    <div class="flex justify-between text-xl font-bold">
        <span>Net Total</span>
        <span class="text-green-600">
            ₹ <%= bill + 20 %>
        </span>
    </div>

    <a
        href="/checkout"
        class="w-full mt-6 block text-center py-3 rounded bg-[#5A0000] text-white font-semibold hover:bg-[#7a0000]">

        Proceed To Checkout

    </a>

</div>
```

</div>


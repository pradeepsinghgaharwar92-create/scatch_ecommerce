<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <% if(isLoggedin){ %>

<!-- Main Navbar -->

<nav class="sticky top-0 z-50 bg-gradient-to-r from-[#5A0000] via-[#7A0000] to-[#5A0000] shadow-xl">

```
<div class="max-w-7xl mx-auto px-8 py-4 flex items-center justify-between">

    <!-- Logo -->
    <a href="/shop" class="flex items-center gap-3">

        <div class="w-11 h-11 rounded-full bg-white flex items-center justify-center shadow-md">
            <i class="ri-shopping-bag-3-fill text-[#5A0000] text-2xl"></i>
        </div>

        <h1 class="text-3xl font-bold text-white tracking-widest">
            SCATCH
        </h1>

    </a>

    <!-- Search Bar -->
    <form action="/search" method="GET" class="relative w-[40%]">

        <i class="ri-search-line absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 text-lg"></i>

        <input
            type="text"
            name="query"
            placeholder="Search for products..."
            class="w-full py-3 pl-12 pr-5 rounded-full shadow-md outline-none focus:ring-2 focus:ring-yellow-400">

    </form>

    <!-- Right Menu -->
    <div class="flex items-center gap-6 text-white font-medium">

        <a href="/shop" class="hover:text-yellow-300 transition flex items-center gap-2">
            <i class="ri-store-2-line text-lg"></i>
            Shop
        </a>

        <a href="/cart" class="hover:text-yellow-300 transition flex items-center gap-2">
            <i class="ri-shopping-cart-2-line text-lg"></i>
            Cart
        </a>

        <a href="/profile" class="hover:text-yellow-300 transition flex items-center gap-2">
            <i class="ri-user-3-line text-lg"></i>
            Account
        </a>

        <a href="/logout"
            class="bg-white text-[#5A0000] px-5 py-2 rounded-full font-semibold hover:scale-105 transition shadow-md">
            Logout
        </a>

    </div>

</div>
```

</nav>

<!-- Category Navbar -->

<nav class="bg-white shadow-md border-b">

```
<div class="max-w-7xl mx-auto flex justify-center gap-12 py-4 text-gray-700 font-semibold">

    <a href="/shop" class="hover:text-[#5A0000] transition">
        Home
    </a>

    <a href="/shop?category=men" class="hover:text-[#5A0000] transition">
        Men
    </a>

    <a href="/shop?category=women" class="hover:text-[#5A0000] transition">
        Women
    </a>

    <a href="/shop?category=bags" class="hover:text-[#5A0000] transition">
        Bags
    </a>

    <a href="/shop?category=accessories" class="hover:text-[#5A0000] transition">
        Accessories
    </a>

    <a href="/shop?category=new" class="hover:text-[#5A0000] transition">
        New Arrivals
    </a>

    <a href="/shop?category=offers" class="text-red-600 hover:text-red-700 transition">
        🔥 Offers
    </a>

</div>
```

</nav>

<% } %>

</body>
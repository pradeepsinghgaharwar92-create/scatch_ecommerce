<%- include('./partials/header') %>

<div class="min-h-screen bg-[#F4F1EE] py-10 px-8">

    <div class="max-w-7xl mx-auto">

        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">

            <div class="grid md:grid-cols-2 gap-10 p-10">

                <!-- IMAGE SECTION -->
                <div>

                    <div class="bg-[#f8f8f8] rounded-2xl p-10 flex justify-center">

                        <img
                            class="h-[450px] object-contain hover:scale-105 transition duration-300"
                            src="data:image/jpeg;base64,<%= product.Image.toString('base64') %>"
                            alt=""
                        >

                    </div>

                </div>

                
                <div>

                    <span
                        class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-semibold">
                        In Stock
                    </span>

                    <h1 class="text-4xl font-bold mt-4">
                        <%= product.name %>
                    </h1>

                    <p class="text-gray-500 mt-2">
                        SCATCH Premium Collection
                    </p>

                    <!-- Rating -->
                    <div class="flex items-center gap-2 mt-4">

                        <div class="text-yellow-500 text-xl">
                            ★★★★★
                        </div>

                        <span class="text-gray-600">
                            (124 Reviews)
                        </span>

                    </div>

                    <!-- Price -->
                    <div class="mt-6">

                        <h2 class="text-4xl font-bold text-[#5A0000]">
                            ₹ <%= product.price %>
                        </h2>

                        <div class="flex items-center gap-3 mt-2">

                            <span class="line-through text-gray-400">
                                ₹ <%= Math.floor(product.price * 1.3) %>
                            </span>

                            <span class="text-green-600 font-semibold">
                                30% OFF
                            </span>

                        </div>

                    </div>

                    
                    <div class="mt-8">

                        <h3 class="text-xl font-semibold mb-3">
                            Product Description
                        </h3>

                        <p class="text-gray-600 leading-7">
                            Premium quality apparel crafted with comfort,
                            durability and modern style in mind.
                            Designed for everyday wear and perfect for all seasons.
                        </p>

                    </div>

                    
                    <div class="mt-8">

                        <h3 class="font-semibold mb-3">
                            Quantity
                        </h3>

                        <div
                            class="flex items-center border w-fit rounded-lg overflow-hidden">

                            <button
                                class="px-4 py-2 bg-gray-100 hover:bg-gray-200">
                                -
                            </button>

                            <span class="px-6 py-2">
                                1
                            </span>

                            <button
                                class="px-4 py-2 bg-gray-100 hover:bg-gray-200">
                                +
                            </button>

                        </div>

                    </div>

                    <!-- Buttons -->
                    <div class="flex gap-4 mt-10">

                        <a
                            href="/addtocart/<%= product._id %>"
                            class="bg-[#5A0000] text-white px-8 py-4 rounded-xl font-semibold hover:bg-[#760000] transition">

                            Add To Cart

                        </a>

                        <a href="/buynow/<%= product._id %>"
                            class="bg-black text-white px-8 py-4 rounded-xl font-semibold hover:opacity-90">

                            Buy Now

                        </a>

                    </div>
                    

<div class="mt-12 bg-white p-6 rounded-xl shadow">

    <h2 class="text-2xl font-bold mb-4">
        Write a Review
    </h2>

    <form action="/product/<%= product._id %>/review" method="POST">

        <div class="mb-4">

            <label class="block mb-2 font-medium">
                Rating
            </label>

            <select
                name="rating"
                class="border rounded-lg p-2 w-full">

                <option value="5">⭐⭐⭐⭐⭐ (5)</option>
                <option value="4">⭐⭐⭐⭐ (4)</option>
                <option value="3">⭐⭐⭐ (3)</option>
                <option value="2">⭐⭐ (2)</option>
                <option value="1">⭐ (1)</option>

            </select>

        </div>

        <div class="mb-4">

            <label class="block mb-2 font-medium">
                Comment
            </label>

            <textarea
                name="comment"
                rows="4"
                class="border rounded-lg p-3 w-full"
                placeholder="Write your review here..."></textarea>

        </div>

        <button
            class="bg-[#5A0000] text-white px-6 py-3 rounded-lg hover:bg-[#750000]">

            Submit Review

        </button>

    </form>

</div>




<div class="mt-12 bg-white p-6 rounded-xl shadow">

    <h2 class="text-2xl font-bold mb-6">
        Customer Reviews
    </h2>

    <% if(product.reviews && product.reviews.length > 0){ %>

        <% product.reviews.forEach(function(review){ %>

            <div class="border-b pb-4 mb-4">

                <h3 class="font-bold text-lg">
                    <%= review.user.fullname %>
                </h3>

                <p class="text-yellow-500">
                    Rating: ⭐ <%= review.rating %>/5
                </p>

                <p class="text-gray-700 mt-2">
                    <%= review.comment %>
                </p>

                <p class="text-sm text-gray-400 mt-2">
                    <%= review.createdAt.toDateString() %>
                </p>

            </div>

        <% }) %>

    <% } else { %>

        <p class="text-gray-500">
            No reviews yet.
        </p>

    <% } %>

</div>

                    
                    <div class="mt-10 border-t pt-6">

                        <h3 class="font-semibold text-xl mb-4">
                            Highlights
                        </h3>

                        <ul class="space-y-2 text-gray-600">

                            <li>✔ Premium Fabric Quality</li>
                            <li>✔ Soft & Comfortable</li>
                            <li>✔ Modern Fit</li>
                            <li>✔ Long Lasting Color</li>
                            <li>✔ Easy Returns</li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>

        
        <div
            class="bg-white rounded-3xl shadow-xl mt-8 p-8">

            <h2 class="text-2xl font-bold mb-5">
                Delivery & Returns
            </h2>

            <div class="grid md:grid-cols-3 gap-6">

                <div>
                    <h4 class="font-semibold">
                        🚚 Free Delivery
                    </h4>
                    <p class="text-gray-500">
                        Delivery within 3-5 business days.
                    </p>
                </div>

                <div>
                    <h4 class="font-semibold">
                        🔄 Easy Returns
                    </h4>
                    <p class="text-gray-500">
                        7 days replacement policy.
                    </p>
                </div>

                <div>
                    <h4 class="font-semibold">
                        🔒 Secure Payments
                    </h4>
                    <p class="text-gray-500">
                        100% secure payment protection.
                    </p>
                </div>

            </div>

        </div>

    </div>

</div>

<%- include('./partials/footer') %>
<div class="w-full flex items-start px-10 py-10 gap-8">

    <!-- Sidebar -->
    <div class="w-[25%] rounded-3xl shadow-xl bg-gradient-to-b from-[#DCCFC2] to-[#F4EDE4] p-8 h-fit border border-white">

        <div class="flex items-center justify-between">
            <h3 class="text-xl font-bold text-[#5A0000]">
                Sort By
            </h3>

            <form action="/shop">
                <select
                    class="border border-gray-300 rounded-xl px-4 py-2 bg-white shadow-sm focus:outline-none"
                    name="sortby">

                    <option value="popular">Popular</option>
                    <option value="newest">Newest</option>

                </select>
            </form>
        </div>

        <div class="mt-12">
            <h2 class="font-bold text-[#5A0000] text-lg mb-5">
                Collections
            </h2>

            <a class="block mb-3 hover:text-[#5A0000] transition-all hover:translate-x-2" href="">
                ✨ New Collection
            </a>

            <a class="block mb-3 hover:text-[#5A0000] transition-all hover:translate-x-2" href="">
                🛍 All Products
            </a>

            <a class="block mb-3 hover:text-[#5A0000] transition-all hover:translate-x-2" href="">
                🔥 Discounted Products
            </a>
        </div>

        <div class="mt-12">
            <h2 class="font-bold text-[#5A0000] text-lg mb-5">
                Filters
            </h2>

            <a class="block mb-3 hover:text-[#5A0000]" href="">
                📦 Availability
            </a>

            <a class="block mb-3 hover:text-[#5A0000]" href="">
                💸 Discount
            </a>
        </div>

    </div>

    <!-- Product Section -->
    <div class="w-[75%]">

        <div class="flex flex-wrap gap-8">

            <% products.forEach(function(product){ %>

            <a href="/product/<%= product._id %>">

                <div class="w-64 bg-white rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">

                    <!-- Product Image -->
                    <div
                        class="w-full h-60 flex items-center justify-center overflow-hidden"
                        style="background-color: <% product.bgcolor %>">

                        <% if(product.Image){ %>

                        <img
                            class="h-[12rem] object-contain hover:scale-110 transition duration-500"
                            src="data:image/jpeg;base64,<%= product.Image.toString('base64') %>"
                            alt="">

                        <% } else { %>

                        <p>No Image</p>

                        <% } %>

                    </div>

                    <!-- Product Footer -->
                    <div
                        class="flex justify-between items-center px-5 py-4"
                        style="background-color:<%= product.panelcolor %>; color:<%= product.textcolor %>;">

                        <div>

                            <h3 class="font-bold text-lg">
                                <%= product.name %>
                            </h3>

                            <h4 class="font-semibold text-xl">
                                ₹ <%= product.price %>
                            </h4>

                        </div>

                        <a
                            class="w-10 h-10 flex items-center justify-center rounded-full bg-white text-black shadow-md hover:bg-[#5A0000] hover:text-white transition-all duration-300"
                            href="/addtocart/<%= product._id %>">

                            <i class="ri-shopping-cart-2-line"></i>

                        </a>

                    </div>

                </div>

            </a>

            <% }) %>

        </div>

    </div>

</div>
```

